{
  "name": "rafarena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A cinematic 3D football replay explorer with deterministic motion and saved perspectives.",
  "author": "Rafayel Karamyan",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "three": "0.186.1",
    "lucide-react": "0.468.0",
    "zod": "4.6.7",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/dm-mono": "5.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.186.0",
    "@types/node": "24.10.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "prettier": "3.6.2",
    "@playwright/test": "1.56.1",
    "@axe-core/playwright": "4.10.2",
    "fake-indexeddb": "6.2.6"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
